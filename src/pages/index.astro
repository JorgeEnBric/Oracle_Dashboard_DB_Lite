---
//Cargando el css
import "../estilos/Index.css";
import "../estilos/Notify.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>Console Lite</title>
        <script>
            import {
                testConnection,
                quickSaveConnection,
                saveEditorContent,
                toggleTNS,
            } from "./api/index.js";
        </script>
    </head>
    <body>
        <div class="main-wrapper">
            <div class="login-container">
                <div class="login-card">
                    <div class="logo-section">
                        <div class="oracle-icon">
                            <svg
                                width="100"
                                height="100"
                                viewBox="0 0 100 100"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <rect
                                    width="100"
                                    height="100"
                                    rx="22"
                                    fill="url(#paint0_linear)"></rect>

                                <path
                                    d="M50 32C62.1503 32 72 29.3137 72 26C72 22.6863 62.1503 20 50 20C37.8497 20 28 22.6863 28 26C28 29.3137 37.8497 32 50 32Z"
                                    fill="white"></path>

                                <path
                                    d="M72 34.5C72 37.8137 62.1503 40.5 50 40.5C37.8497 40.5 28 37.8137 28 34.5V30.125C31.5 32.5 40.5 33.5 50 33.5C59.5 33.5 68.5 32.5 72 30.125V34.5Z"
                                    fill="white"></path>

                                <path
                                    d="M72 45.5C72 48.8137 62.1503 51.5 50 51.5C37.8497 51.5 28 48.8137 28 45.5V41.125C31.5 43.5 40.5 44.5 50 44.5C59.5 44.5 68.5 43.5 72 41.125V45.5Z"
                                    fill="white"></path>

                                <path
                                    d="M72 56.5C72 59.8137 62.1503 62.5 50 62.5C37.8497 62.5 28 59.8137 28 56.5V52.125C31.5 54.5 40.5 55.5 50 55.5C59.5 55.5 68.5 54.5 72 52.125V56.5Z"
                                    fill="white"></path>

                                <path
                                    d="M72 67.5C72 70.8137 62.1503 73.5 50 73.5C37.8497 73.5 28 70.8137 28 67.5V63.125C31.5 65.5 40.5 66.5 50 66.5C59.5 66.5 68.5 65.5 72 63.125V67.5Z"
                                    fill="white"></path>

                                <defs>
                                    <linearGradient
                                        id="paint0_linear"
                                        x1="50"
                                        y1="0"
                                        x2="50"
                                        y2="100"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop stop-color="#FF3B30"></stop>

                                        <stop offset="1" stop-color="#D70015"
                                        ></stop>
                                    </linearGradient>
                                </defs>
                            </svg>
                        </div>
                        <h1>Oracle Console Lite</h1>
                        <p class="subtitle">Database Management System Lite</p>
                    </div>

                    <form action="/api/connect" method="POST">
                        <div class="input-group">
                            <label for="savedConnections"
                                >Conexiones Guardadas</label
                            >
                            <select id="savedConnections" class="custom-select">
                                <option value=""
                                    >-- Seleccionar conexión --</option
                                >
                            </select>
                        </div>

                        <div class="input-group">
                            <label for="usuario">Usuario</label>
                            <input
                                type="text"
                                id="usuario"
                                name="usuario"
                                placeholder="DBA"
                            />
                        </div>

                        <div class="input-group">
                            <label for="password">Contraseña</label>
                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Pass"
                            />
                        </div>

                        <div class="grid-inputs">
                            <div class="input-group">
                                <label for="host">Host</label>
                                <input
                                    type="text"
                                    id="host"
                                    name="host"
                                    placeholder="localhost"
                                    required
                                />
                            </div>
                            <div class="input-group">
                                <label for="port">Puerto</label>
                                <input
                                    type="number"
                                    id="port"
                                    name="port"
                                    value="1521"
                                    required
                                />
                            </div>
                        </div>

                        <div class="input-group">
                            <label for="service">Service Name</label>
                            <input
                                type="text"
                                id="service"
                                name="service"
                                placeholder="ORCLPDB1"
                                required
                            />
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn-primary"
                                >Conectar</button
                            >
                            <button
                                type="button"
                                id="saveQuickConn"
                                class="btn-save">Guardar Conexión</button
                            >
                            <div
                                class="grid-inputs"
                                style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0;"
                            >
                                <button
                                    type="button"
                                    id="testButton"
                                    class="btn-secondary">Test</button
                                >
                                <button
                                    type="button"
                                    id="addTNS"
                                    class="btn-secondary">JSON</button
                                >
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <section id="tnsPanel" class="tns-editor">
                <p
                    style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 10px;"
                >
                    Tus conexiones en connections.json
                </p>
                <textarea id="editConnections" spellcheck="false"></textarea>
                <button
                    type="button"
                    id="saveTNS"
                    class="btn-primary"
                    style="margin-top: 10px;">Actualizar JSON</button
                >
            </section>
        </div>
        <div id="toast-container" class="toast-container"></div>
    </body>
</html>

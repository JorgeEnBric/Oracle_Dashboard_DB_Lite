---
import Table from './Table.astro';
import { executeQuery } from '../server.js';

const sessionCookie = Astro.cookies.get('db_session')?.json();
console.log(sessionCookie);

let data = [];
let data2 = [];
let error = null;

if (!sessionCookie) {
    // Si no hay sesión, redirigimos al login
    return Astro.redirect('/login');
}

try {
    let query = `
        select SubStr(S.Event,1,30) Event,count(1) as "Cantidad"
        From gV$SESSION S, V$SESSION_WAIT W, V$PROCESS P
        Where S.SID = W.SID(+)
        And S.PAddr(+) = P.Addr
        And (S.Status = 'ACTIVE')
        And S.Username is not null
        group by S.event
    `;
    data = await executeQuery(query, sessionCookie);
    let query2 = `
        SELECT 
    ash.event,
    ash.FORCE_MATCHING_SIGNATURE, 
    ROUND(COUNT(*) / 60, 2) AS ESTIMATED_WAIT_MINUTES,
    ROUND(SUM(ash.TIME_WAITED) / 1000000 / 60, 2) AS RECORDED_WAIT_MINUTES,
    COUNT(*) AS SAMPLES,
    MAX(ash.SQL_ID) AS SQL_ID,
    MAX(DBMS_LOB.SUBSTR(sq.SQL_TEXT, 100, 1)) AS SQL_TEXT_SHORT
    FROM gv$active_session_history ash
    JOIN gv$sqlarea sq 
        ON  ash.SQL_ID = sq.SQL_ID 
        AND ash.INST_ID = sq.INST_ID
    WHERE ash.sample_time > SYSDATE - 1/24 
    AND ash.FORCE_MATCHING_SIGNATURE > 0
    AND ash.event IS NOT NULL
    GROUP BY ash.FORCE_MATCHING_SIGNATURE, ash.event
    HAVING (COUNT(*) / 60) > 5
    ORDER BY ESTIMATED_WAIT_MINUTES DESC
    `;
    data2 = await executeQuery(query2, sessionCookie);

    console.log('Resultado de la consulta:', data);
} catch (e) {
    error = e.message;
}
---
<div class="activeevent-zone ">
    {data? (
        <Table data={data} title="Eventos Activos" />
    ) : (
        <p>No hay datos disponibles.</p>
    )}
    {data2? (
        <Table data={data2} title="Active Session History (última hora)" />
    ) : (
        <p>No hay datos disponibles.</p>
    )}
</div>
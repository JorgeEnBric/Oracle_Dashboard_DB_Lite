---
// src/components/ActiveSessionsChart.astro
import { executeQuery } from '../server.js';

const sessionCookie = Astro.cookies.get('db_session')?.json();

if (!sessionCookie) {
    return Astro.redirect('/login');
}


let rawData: AshRow[] = [];
let error = null;

interface AshRow {
    TIEMPO: string;
    TIPO: string;
    SESIONES: number;
}

try {
    rawData = await executeQuery(`
        SELECT 
            TO_CHAR(SAMPLE_TIME, 'HH24:MI') AS TIEMPO,
            NVL(WAIT_CLASS, 'CPU/Other') AS TIPO,
            COUNT(*) AS SESIONES
        FROM 
            V$ACTIVE_SESSION_HISTORY
        WHERE 
            SAMPLE_TIME >= SYSDATE - (1/24)
        GROUP BY 
            TO_CHAR(SAMPLE_TIME, 'HH24:MI'),
            NVL(WAIT_CLASS, 'CPU/Other')
        ORDER BY 
            1 desc, 2
    `, sessionCookie) as AshRow[];
} catch (e) {
    error = e.message;
}

//console.log('Datos crudos de ASH:', rawData);
// Procesar datos en el servidor para pasarlos al cliente
// Extraer labels únicos (minutos) y tipos únicos (wait classes)
const labelsSet = new Set<string>();
const tiposSet  = new Set<string>();

for (const row of rawData) {
    labelsSet.add(row.TIEMPO);
    tiposSet.add(row.TIPO);
}

const labels = Array.from(labelsSet).sort();
const tipos  = Array.from(tiposSet).sort();

// Construir matriz: tipo → { minuto: count }
const matrix: Record<string, Record<string, number>> = {};
for (const tipo of tipos) {
    matrix[tipo] = {};
    for (const label of labels) {
        matrix[tipo][label] = 0;
    }
}
for (const row of rawData) {
    matrix[row.TIPO][row.TIEMPO] = Number(row.SESIONES);
}

// Paleta de colores por tipo de espera (compatible con wait_class de Oracle)
const COLOR_MAP: Record<string, string> = {
    'CPU/Other':        '#3b82f6',  // Azul
    'User I/O':         '#f59e0b',  // Ámbar
    'System I/O':       '#8b5cf6',  // Violeta
    'Wait':             '#ef4444',  // Rojo
    'Concurrency':      '#ec4899',  // Rosa
    'Application':      '#06b6d4',  // Cyan
    'Commit':           '#10b981',  // Verde
    'Network':          '#f97316',  // Naranja
    'Administrative':   '#6b7280',  // Gris
    'Configuration':    '#84cc16',  // Lima
    'Scheduler':        '#a78bfa',  // Lavanda
    'Cluster':          '#fb7185',  // Coral
    'Other':            '#94a3b8',  // Slate
};

function getColor(tipo: string): string {
    return COLOR_MAP[tipo] ?? '#94a3b8';
}

// Serializar para el cliente
const chartLabels   = labels;
const chartDatasets = tipos.map(tipo => ({
    label: tipo,
    data: labels.map(l => matrix[tipo][l]),
    backgroundColor: getColor(tipo) + 'cc',
    borderColor:     getColor(tipo),
    borderWidth: 1,
}));

//console.log('labels server:', labels);
//console.log('datasets server:', chartDatasets);
---

<div class="chart-card">
    <div class="chart-header">
        <h3>Sesiones Activas — Última Hora</h3>
        <span class="status-badge">● Live</span>
    </div>

    {error ? (
        <div class="chart-error">⚠ Error al cargar datos: {error}</div>
    ) : rawData.length === 0 ? (
        <div class="chart-empty">Sin actividad en la última hora.</div>
    ) : (
        <div class="chart-container">
            <canvas id="sessionsChart"></canvas>
        </div>
    )}
</div>



<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script define:vars={{ chartLabels, chartDatasets }}>
    
    const ctx = document.getElementById('sessionsChart');
    if (!ctx) return;

    const labels   = chartLabels;
    const datasets = chartDatasets;
    console.log('labels:', labels);
    console.log('datasets:', datasets);

    new Chart(ctx, {
        type: 'bar',
        data: { labels, datasets },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',       // Tooltip muestra todos los tipos del mismo minuto
                intersect: false,
            },
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        color: '#94a3b8',
                        boxWidth: 12,
                        padding: 16,
                        font: { size: 11 },
                    },
                },
                tooltip: {
                    backgroundColor: '#1e293b',
                    borderColor: '#334155',
                    borderWidth: 1,
                    titleColor: '#e2e8f0',
                    bodyColor: '#94a3b8',
                    callbacks: {
                        // Mostrar total al final del tooltip
                        footer: (items) => {
                            const total = items.reduce((sum, i) => sum + i.parsed.y, 0);
                            return `Total: ${total} sesiones`;
                        }
                    }
                },
            },
            scales: {
                x: {
                    stacked: true,
                    grid: { display: false },
                    ticks: { color: '#94a3b8', maxRotation: 45, font: { size: 10 } },
                    title: {
                        display: true,
                        text: 'Hora (HH:MM)',
                        color: '#64748b',
                        font: { size: 11 },
                    },
                },
                y: {
                    stacked: true,
                    beginAtZero: true,
                    grid: { color: 'rgba(255,255,255,0.05)' },
                    ticks: { color: '#94a3b8', font: { size: 11 } },
                    title: {
                        display: true,
                        text: 'Sesiones',
                        color: '#64748b',
                        font: { size: 11 },
                    },
                },
            },
        },
    });
</script>

<style>
    .chart-card {
        background-color: #1a1d26;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 1.5rem;
        width: 100%;
        margin-bottom: 2rem;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    h3 {
        color: #e2e8f0;
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        border-left: 4px solid #3b82f6;
        padding-left: 0.75rem;
    }

    .status-badge {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.5; }
    }

    .chart-container {
        height: 320px;
        position: relative;
    }

    .chart-error,
    .chart-empty {
        padding: 2rem;
        text-align: center;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .chart-error {
        background: rgba(239, 68, 68, 0.08);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .chart-empty {
        background: rgba(100, 116, 139, 0.08);
        color: #64748b;
        border: 1px dashed #334155;
    }
</style>
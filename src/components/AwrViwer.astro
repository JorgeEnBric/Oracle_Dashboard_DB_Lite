---
// src/components/AwrViewer.astro
interface Props {
  htmlContent: string;
}

const { htmlContent } = Astro.props;
---

<div class="awr-container">
  <div class="awr-header">
    <h3>Reporte AWR Generado</h3>
    <div class="actions">
      <button id="downloadHTML" class="btn-download">Descargar HTML</button>
    </div>
  </div>
  
  {htmlContent ? (
    <iframe 
      id="awrFrame"
      srcdoc={htmlContent} 
      title="Oracle AWR Report"
      sandbox="allow-same-origin allow-scripts"
    ></iframe>
  ) : (
    <div class="error">No se pudo generar el contenido del reporte.</div>
  )}
</div>

<script>
  document.getElementById("downloadHTML")?.addEventListener("click", () => {
    // 1. Obtenemos el iframe
    const iframe = document.getElementById("awrFrame") as HTMLIFrameElement;
    
    if (!iframe) {
      alert("No hay reporte disponible para descargar.");
      return;
    }

    // 2. Extraemos el contenido (el srcdoc que le pasamos desde Astro)
    // Usamos el atributo 'srcdoc' directamente ya que contiene el HTML completo de Oracle
    const content = iframe.getAttribute('srcdoc');

    if (content) {
      const blob = new Blob([content], { type: 'text/html' });
      const url = window.URL.createObjectURL(blob);
      
      // 3. Creamos el link de descarga temporal
      const a = document.createElement('a');
      
      // Intentamos obtener los snaps de la URL para el nombre del archivo
      const params = new URLSearchParams(window.location.search);
      const start = params.get('start') || 'start';
      const end = params.get('end') || 'end';
      
      a.href = url;
      a.download = `awr_report_${start}_${end}.html`;
      
      document.body.appendChild(a);
      a.click();
      
      // 4. Limpieza
      window.URL.revokeObjectURL(url);
      document.body.removeChild(a);
    }
  });
</script>

<style>
  .awr-container {
    height: 85vh;
    display: flex;
    flex-direction: column;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: white;
  }
  .awr-header {
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f1f5f9;
    border-bottom: 1px solid #cbd5e1;
  }
  .actions {
    display: flex;
    gap: 10px;
  }
  iframe {
    flex-grow: 1;
    border: none;
    width: 100%;
  }
  .btn-print, .btn-download {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
  }
  .btn-print {
    background: #2563eb;
    color: white;
  }
  .btn-download {
    background: #10b981; /* Verde esmeralda para descarga */
    color: white;
  }
  .btn-print:hover { background: #1d4ed8; }
  .btn-download:hover { background: #059669; }
  
  .error {
    padding: 2rem;
    color: #dc2626;
    text-align: center;
  }
</style>
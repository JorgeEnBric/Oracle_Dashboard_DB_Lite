---
import { executeQuery } from '../oracledb.js';
import Table from './Table.astro';

const sessionCookie = Astro.cookies.get('db_session')?.json();
console.log(sessionCookie);

let data = [];
let error = null;

if (!sessionCookie) {
    // Si no hay sesión, redirigimos al login
    //return Astro.redirect('/login');
}

try {
    data = await executeQuery("SELECT originating_timestamp, message_text FROM v$diag_alert_ext WHERE message_text LIKE '%ORA-%' AND  rownum <= 10 ORDER BY originating_timestamp DESC", sessionCookie);
    
} catch (e) {
    error = e.message;
}
---
<div class="alert-zone ">
    {data.length > 0 ? (
        <Table data={data} title="Alertlog last 10 days" />
    ) : (
        <p>No hay datos disponibles.</p>
    )}
</div>
---
import { executeQuery } from '../oracledb.js';
import Table from './Table.astro';

const sessionCookie = Astro.cookies.get('db_session')?.json();
//console.log(sessionCookie);

let data = [];
let error = null;

if (!sessionCookie) {
    // Si no hay sesión, redirigimos al login
    //return Astro.redirect('/login');
}

try {
    data = await executeQuery('SELECT name, open_mode, log_mode FROM v$database', sessionCookie);
} catch (e) {
    error = e.message;
}


---
<div class="statusdb-zone">
    {error ? (
        <p class="error-message">Error al obtener el estado de la base de datos: {error}</p>
    ) : data.length > 0 ? (
        <Table data={data} title="Estado de la base de datos" />
    ) : (
        <p>No hay datos disponibles.</p>
    )}
</div>